# Supabase — required for the admission registration backend
# (lib/supabase/, lib/actions/admissions.ts) to function.
#
# Get these from your Supabase project: Settings -> API.
#
# NEXT_PUBLIC_* variables are safe to expose to the browser (Next.js
# inlines them into the client bundle at build time). The service role
# key is NOT public-prefixed and must never be — it's only read by
# lib/supabase/server-client.ts, which is guarded by the `server-only`
# package so importing it from a Client Component fails at build time.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Setup:
#   1. Create a project at https://supabase.com
#   2. Run the migration in supabase/migrations/0001_admission_applications.sql
#      against it (Supabase Dashboard -> SQL Editor, or `supabase db push`
#      if you're using the Supabase CLI)
#   3. Copy this file to .env.local and fill in the three values above
#   4. Restart the dev server
